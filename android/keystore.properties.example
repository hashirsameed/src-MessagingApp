# Copy this file to `keystore.properties` (same folder) and fill in your
# real release keystore details. `keystore.properties` itself is
# git-ignored — never remove it from .gitignore or commit your real
# passwords/keystore.
#
# Generate a release keystore first, e.g.:
#   keytool -genkeypair -v -storetype PKCS12 -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias my-release-key -keystore my-release-key.keystore
#
# Then place the .keystore file somewhere OUTSIDE the repo (or in
# android/app/ and keep that path git-ignored too), and fill in below:

storeFile=/absolute/or/relative/path/to/my-release-key.keystore
storePassword=CHANGE_ME
keyAlias=my-release-key
keyPassword=CHANGE_ME
